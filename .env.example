# Local development only. Production always requires a visitor credential.
# Connect OpenRouter (or OpenAI / Anthropic) after the first send in production.
OPENROUTER_API_KEY=

# Optional overrides when using the server key
# RESUME_PROVIDER=openrouter
# RESUME_MODEL=z-ai/glm-5.3-flash

# Optional. Raises GitHub's API limit from 60 requests an hour to 5000.
# A token with no scopes is enough — only public data is read.
# GITHUB_TOKEN=

# Optional. Renders JavaScript-heavy pages that a plain fetch comes back empty
# on. Free key at https://jina.ai/reader. Without it those pages are skipped;
# anonymous use is blocked on whole ISPs, so there is no point trying keyless.
# JINA_API_KEY=

# Optional, and all-or-nothing: without a database nothing is written down, so
# a reload starts over and none of the rest of this section applies.
# Schema lives in db/schema.sql — apply it with `pnpm db:push`.
#
# Supabase, through the transaction pooler on port 6543 — not the direct host,
# which resolves to IPv6 only and hands out a connection per invocation.
# Dashboard → Connect → Transaction pooler.
# DATABASE_URL=

# Required in production, along with DATABASE_URL. Use at least 32 random
# characters. API requests fail closed when either is missing.
# Signs ownership cookies and keys the shared request quotas.
# Generate with `openssl rand -hex 32`.
# AUTH_SECRET=

# Optional. Offers Continue with ChatGPT on a deployment. Locally, on
# 127.0.0.1, it works without these. OpenAI issues the client through
# https://openai.com/form/sign-in-with-chatgpt-interest/ — register
# https://<your-domain>/auth/chatgpt as its callback. The secret is only for a
# confidential client.
# OPENAI_OAUTH_CLIENT_ID=
# OPENAI_OAUTH_CLIENT_SECRET=

# Optional. Keeps the uploaded PDF so it survives a reload; without them the
# upload lives as long as the tab. The bucket is private, so the service role
# is what signs each read — it must never reach the browser.
# SUPABASE_URL=
# SUPABASE_SERVICE_ROLE_KEY=

# Required by the nightly sweep in vercel.json, which deletes threads nobody
# has opened and the files they held. Unset, the endpoint 404s and never runs —
# an open endpoint that deletes things is worse than one that doesn't.
# Vercel sends this automatically for scheduled crons.
# CRON_SECRET=

# How long a thread survives without being opened. Defaults to 7.
# THREAD_RETENTION_DAYS=7

# Google Tag Manager container GTM-NPCFMW6S is configured in lib/analytics.ts.
# No analytics secret is needed in this app. Configure the GA4 Google tag and
# custom-event forwarding inside GTM; see README before publishing tags.
